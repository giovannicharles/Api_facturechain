# FactureChain Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# ==========================================
# MONGODB ATLAS — Configuration en ligne
# ==========================================
# Récupérer sur : https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://facture_chain_user:facturechainpwd@cluster0.tz8ppl3.mongodb.net/Cluster0?retryWrites=true&w=majority

# MONGO_URI=mongodb+srv://ebodegiovanni_db_user:nextlearn_@nextlearndb.fcepgn6.mongodb.net/nextlearnDB?retryWrites=true&w=majority
# ==========================================
# JWT — Authentification
# ==========================================
JWT_SECRET=facturechain_jwt_secret_super_secure_2025
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=change_me_in_production_access
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# ==========================================
# CLOUDINARY — Stockage des preuves
# ==========================================
# Récupérer sur : https://cloudinary.com/console
# CLOUDINARY_URL=cloudinary://212823171682555:Ed7q74ZyYskUKyXc9z95Tbb9ekg@dw3ge4b0x
CLOUDINARY_CLOUD_NAME=dw3ge4b0x
CLOUDINARY_API_KEY=212823171682555
CLOUDINARY_API_SECRET=Ed7q74ZyYskUKyXc9z95Tbb9ekg
CLOUDINARY_FOLDER=facturechain/preuves

# ==========================================
# SERVEUR
# ==========================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# ==========================================
# BLOCKCHAIN (simulation Ethereum Sepolia)
# ==========================================
BLOCKCHAIN_NETWORK=ethereum-sepolia
BLOCKCHAIN_CONTRACT_ADDRESS=0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
PRIVATE_KEY=271ce5628d285ecf7ecf4a2d634329fa67bf42dddedf0fc50751912a5e0cd61a

# 0xdbc93ac138acbd37ab41a92a4a5ad1b74863157fbf6e3bf4d1db6f579e74e213

CORS_ORIGINS=http://localhost:4200,https://mobile-facturechain.vercel.app,https://frontend-facturechain-web.vercel.app,https://localhost,http://localhost,capacitor://localhost,ionic://localhost,http://localhost:49155,http://localhost:8081,https://admin-facturechain-web.vercel.app

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Adapter ENEO ----
# 'mock' = utilise les données de seed locales (par défaut)
# 'http' = appelle une vraie API ENEO (URL et clé ci-dessous)
ENEO_ADAPTER_MODE=mock
ENEO_API_BASE_URL=
ENEO_API_KEY=

# ---- Ledger (préparation blockchain) ----
# 'hashchain' = chaîne de hash interne (par défaut, immutabilité interne)
# 'blockchain' = stub pour future intégration on-chain
LEDGER_MODE=hashchain