# ---- Environnement ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- Base de données ----
# Pour un Mongo local : mongodb://127.0.0.1:27017/facturechain
# Pour Mongo Atlas : mongodb+srv://<user>:<pwd>@<cluster>/facturechain?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/facturechain

# ---- Sécurité / JWT ----
JWT_ACCESS_SECRET=change_me_in_production_access
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- CORS ----
# Liste séparée par virgules des origines autorisées (apps web + mobile en dev)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:8081,http://localhost:19006

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Adapter ENEO ----
# 'mock' = utilise les données de seed locales (par défaut)
# 'http' = appelle une vraie API ENEO (URL et clé ci-dessous)
ENEO_ADAPTER_MODE=mock
ENEO_API_BASE_URL=
ENEO_API_KEY=

# ---- Ledger (préparation blockchain) ----
# 'hashchain' = chaîne de hash interne (par défaut, immutabilité interne)
# 'blockchain' = stub pour future intégration on-chain
LEDGER_MODE=hashchain
